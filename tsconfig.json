{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@web/*": ["./src/web/*"],
      "@h5/*": ["./src/h5/*"],
      "@shared/*": ["./src/shared/*"],
      "@lottery/*": ["./src/shared/lottery/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "src/**/*.vue","src/**/*.d.ts"],
  "exclude": ["node_modules"]
}