    "desc": {
      "form": {
        "title": "形态",
        "r1": "开奖号码≥5为“大”，≤4为“小”。",
        "r2": "开奖号码1、3、5、7、9为“单”，0、2、4、6、8为“双”。",
        "r3": "开奖号码1、2、3、5、7为“质”，0、4、6、8、9为“合”。",
        "eg": "投注“大”，该球开奖号码为8，即中奖。"
      },
      "number": {
        "title": "号码",
        "r1": "选择0-9中的一个号码，与该球开奖号码一致即中奖。",
        "eg": "投注“8”，该球开奖号码为8，即中奖。"
      },
      "longhu": {
        "title": "龙虎",
        "r1": "两个位置的开奖号码比大小：前＞后为“龙”，前＜后为“虎”，相同为“和”。",
        "eg": "投注“龙”，前位＞后位，即中奖。"
      },
      "zjh": {
        "title": "扎金花",
        "baozi": "豹子：3个相同的号码。",
        "shunzi": "顺子：3个相连的号码（顺序不限）。",
        "duizi": "对子：2个相同 + 1个不同。",
        "zaliu": "杂六：3个各不相同且不相连。",
        "banshun": "半顺：3个不同，其中2个相连。",
        "eg": "投注“豹子”，所选三球开出3个相同号码，即中奖。"
      },
      "suoha": {
        "title": "梭哈",
        "r1": "按五球组成的牌型投注：四条/葫芦/顺子/三条/两对/一对/单牌。",
        "eg": "投注“四条”，五球出现4个相同号码，即中奖。"
      },
      "danma": {
        "title": "单码",
        "r1": "选择0-9的号码，命中开奖号码即中奖（按中奖个数分档）。",
        "eg": "投注“8”，开奖号码中含8，即中奖。"
      },
      "kuadu": {
        "title": "跨度",
        "r1": "所选位置开奖号码的最大值减最小值（差值0-9）。",
        "eg": "投注“3”，所选位置差值为3，即中奖。"
      },
      "zonghe": {
        "title": "总和大小",
        "r1": "五球之和：≥23为大，≤22为小；个位单双；及大小与单双的组合。",
        "eg": "投注“大”，五球之和≥23，即中奖。"
      },
      "zonghewei": {
        "title": "总和单双",
        "r1": "五球之和的尾数：大/小/单/双/质/合。",
        "eg": "投注“单”，五球之和尾数为单，即中奖。"
      },
      "sum": {
        "title": "和数",
        "r1": "所选位置开奖号码之和；对称和值（如0与18）赔率相同。",
        "eg": "投注“9”，所选位置之和为9，即中奖。"
      },
      "douniu": {
        "title": "斗牛",
        "r1": "五球按斗牛规则取牛型：牛牛/牛一~牛九/没牛，及牛大小单双质合。",
        "eg": "投注“牛牛”，五球组成牛牛，即中奖。"
      }
    }
  },
