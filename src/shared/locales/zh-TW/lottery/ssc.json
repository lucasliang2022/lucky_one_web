    "desc": {
      "form": {
        "title": "形態",
        "r1": "開獎號碼≥5為「大」，≤4為「小」。",
        "r2": "開獎號碼1、3、5、7、9為「單」，0、2、4、6、8為「雙」。",
        "r3": "開獎號碼1、2、3、5、7為「質」，0、4、6、8、9為「合」。",
        "eg": "投注「大」，該球開獎號碼為8，即中獎。"
      },
      "number": {
        "title": "號碼",
        "r1": "選擇0-9中的一個號碼，與該球開獎號碼一致即中獎。",
        "eg": "投注「8」，該球開獎號碼為8，即中獎。"
      },
      "longhu": {
        "title": "龍虎",
        "r1": "兩個位置的開獎號碼比大小：前＞後為「龍」，前＜後為「虎」，相同為「和」。",
        "eg": "投注「龍」，前位＞後位，即中獎。"
      },
      "zjh": {
        "title": "扎金花",
        "baozi": "豹子：3個相同的號碼。",
        "shunzi": "順子：3個相連的號碼（順序不限）。",
        "duizi": "對子：2個相同 + 1個不同。",
        "zaliu": "雜六：3個各不相同且不相連。",
        "banshun": "半順：3個不同，其中2個相連。",
        "eg": "投注「豹子」，所選三球開出3個相同號碼，即中獎。"
      },
      "suoha": {
        "title": "梭哈",
        "r1": "按五球組成的牌型投注：四條/葫蘆/順子/三條/兩對/一對/單牌。",
        "eg": "投注「四條」，五球出現4個相同號碼，即中獎。"
      },
      "danma": {
        "title": "單碼",
        "r1": "選擇0-9的號碼，命中開獎號碼即中獎（按中獎個數分檔）。",
        "eg": "投注「8」，開獎號碼中含8，即中獎。"
      },
      "kuadu": {
        "title": "跨度",
        "r1": "所選位置開獎號碼的最大值減最小值（差值0-9）。",
        "eg": "投注「3」，所選位置差值為3，即中獎。"
      },
      "zonghe": {
        "title": "總和大小",
        "r1": "五球之和：≥23為大，≤22為小；個位單雙；及大小與單雙的組合。",
        "eg": "投注「大」，五球之和≥23，即中獎。"
      },
      "zonghewei": {
        "title": "總和單雙",
        "r1": "五球之和的尾數：大/小/單/雙/質/合。",
        "eg": "投注「單」，五球之和尾數為單，即中獎。"
      },
      "sum": {
        "title": "和數",
        "r1": "所選位置開獎號碼之和；對稱和值（如0與18）賠率相同。",
        "eg": "投注「9」，所選位置之和為9，即中獎。"
      },
      "douniu": {
        "title": "鬥牛",
        "r1": "五球按鬥牛規則取牛型：牛牛/牛一~牛九/沒牛，及牛大小單雙質合。",
        "eg": "投注「牛牛」，五球組成牛牛，即中獎。"
      }
    }
  },
